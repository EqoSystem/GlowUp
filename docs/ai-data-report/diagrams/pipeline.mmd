  F -->|no| G{"Online and AI budget left?<br/>(2 per visit)"}
  G -->|yes| H["Gemini: one picture + text<br/>accepted >= 0.45, 25-35 s time-out"]
  G -->|no| J["Shortlist >= 0.45, typed name,<br/>or one photo for an admin"]
  H -->|named| L["List: pack first, then a<br/>sourced web page"]
  H -->|not named| J
  J --> L
  K --> M["Analysis ON THE PHONE<br/>against the saved profile"]
  L --> M
  M --> N["safe / caution / harmful<br/>reasons, sources, shades"]
  M -.-> O["Background: FDA Philippines,<br/>Open Beauty Facts by barcode"]
