  p --> ap["Approve: Active,<br/>reviewed true"]
  b --> sn["Pending snapshot reviews:<br/>approve / edit / reject"]
  b --> cl["Clean up / Find duplicates:<br/>preview, confirm each step"]
  w --> app["App picks the change up<br/>on its next sync"]
  ap --> app
  r --> rr["Restore, or delete forever<br/>after a JSON backup download"]
  a4 --> so["Sign out: lists cleared<br/>from this browser"]
