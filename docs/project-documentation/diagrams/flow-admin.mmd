flowchart TB
  a0(["Open site: /_Index/index.html"]) --> a1["Log in: e-mail + password<br/>(Firebase Auth)"]
  a1 --> a2{"Document in admins/uid?"}
  a2 -->|"no"| a3["Signed out again,<br/>refused at login"]
