rules_version = '2';

// GlowUp: one database shared by the admin website and the mobile app.
//
// BEFORE YOU PUBLISH THESE RULES: add your own admin account to the "admins" collection
// (see FIRESTORE_SCHEMA.md, "Admin accounts"). Without that document the website can still
// read, but every Save and Delete on the website will be refused.
//
// To publish: firebase deploy --only firestore:rules (Vercel does not publish these).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // An admin is an account whose UID is the id of a document in "admins", OR an account that carries the custom claim admin = true
    // (set with the Firebase Admin SDK, never from a browser or the app: a claim cannot be changed by its owner). The website's login
    // gate still looks at "admins"; the claim is for scripts and tools that sign in as an admin. Neither path can be set from the app.
    function isAdmin() {
      return signedIn()
        && (request.auth.token.get('admin', false) == true
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // What the app itself adds to the catalogue (an ingredient its AI lookup found, a product or
    // brand it met in a scan) must carry the user's own id and must be marked "not reviewed".
    // The app can only CREATE such entries: it can never change or delete anything in the catalogue.
    function addedByTheApp() {
      return signedIn()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.reviewed == false
        && request.resource.data.addedAtUnix is number;
    }

    // GlowUp lists MAKE-UP AND FACE PRODUCTS ONLY. What the app adds from a scan must not be a hair, body, nail or
    // fragrance product. The same rule as productScope() on the website (adminCommon.js) and ProductScope.cs in the app:
    // a make-up type is always fine; otherwise a hair / body word is refused unless a face word stands next to it.
    function makeupWords(text) {
      return text.matches('(?is).*\\b(lipstick|lip gloss|lip tint|lip balm|lip liner|gloss|tint|foundation|concealer|primer|powder|blush|blusher|bronzer|highlighter|contour|eyeshadow|eye shadow|eyeliner|liner|mascara|brow|cushion|bb cream|cc cream|makeup|make-up|setting spray)\\b.*');
    }
    function faceWords(text) {
      return text.matches('(?is).*\\b(face|facial|lip|lips|eye|eyes|brow|brows|lash|lashes|cheek|cheeks|complexion)\\b.*');
    }
    function notFaceWords(text) {
      return text.matches('(?is).*\\b(shampoo|conditioner|hair|scalp|body|hand|hands|foot|feet|nail|nails|deodorant|antiperspirant|perfume|fragrance|cologne|eau de|soap|shower|bath|shaving|shave|toothpaste|oral|intimate|baby|tanning|massage)\\b.*');
    }
    function faceProduct(type, name) {
      return makeupWords(type) || !notFaceWords(type + ' ' + name) || faceWords(type + ' ' + name);
    }

    // item i of a list of links: absent, or text of at most 300 characters starting with https:// (nothing else is accepted)
    function httpsLink(list, i) {
      return list.size() <= i || (list[i] is string && list[i].size() <= 300 && list[i].matches('https://[^ ]+'));
    }

    // The id of a staged product is made from its brand, its name and the sender: "snap_<brand>__<name>__<uid>", brand and name each as lower-case letters and digits with "_"
    // between the words (PendingProductRepository.IdFor in the app). Nobody can stage a product under another product's id: for names in
    // plain ASCII the id must be exactly what the brand and the name make (cut at 110 characters). A name with accents or another alphabet
    // is folded by the app in a way these rules cannot repeat, so for those the id only has to match the stored key.
    function slugOf(t) {
      return t.lower().replace('[^a-z0-9]+', '_').replace('^_+|_+$', '');
    }
    function plainAscii(t) {
      return t.matches('[ -~]*');
    }
    function stagedId(brand, name) {
      let b = slugOf(brand);
      return 'snap_' + (b == '' ? 'nobrand' : b) + '__' + slugOf(name);
    }
    // The id ends with "__" + the sender's account id, so every user has an entry of their own and nobody can block another user by staging
    // a product first. The name part is cut so that the whole id is at most 110 characters.
    function idFitsNames(id, data, uid) {
      let tail = '__' + uid;
      let base = id.replace(tail + '$', '');
      return id == 'snap_' + data.key
        && id.matches('snap_.+' + tail)
        && (!(plainAscii(data.brandName) && plainAscii(data.name))
            || base == stagedId(data.brandName, data.name)
            || (base.size() == 110 - tail.size() && base.matches('[a-z0-9_]+') && stagedId(data.brandName, data.name).matches(base + '.*')));
    }

    // the UTC day as 20261022: the quota documents are named with it, so a client cannot pick another day
    function dayStamp(t) {
      return string(t.year() * 10000 + t.month() * 100 + t.day());
    }

    // ---- who is an admin -------------------------------------------------------------------
    // Created and removed only by hand in the Firebase console. An account may look up its own
    // entry (the website does this when "REQUIRE_ADMIN_RECORD" is switched on).
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // What an admin may write to the catalogue (brands, products, ingredients). The website's own forms keep to this already;
    // the rule is a second lock: a name that is not text, a list that is absurdly long, or a "link" that is not an https
    // address is refused, whatever tool wrote it. Kept loose on purpose so old entries can still be saved.
    function sizedList(field, most) {
      return request.resource.data.get(field, []) is list && request.resource.data.get(field, []).size() <= most;
    }
    function httpsOrEmpty(field) {
      return request.resource.data.get(field, '') == ''
        || (request.resource.data.get(field, '') is string
            && request.resource.data.get(field, '').matches('https://.*')
            && request.resource.data.get(field, '').size() <= 300);
    }
    function adminCatalogueWrite() {
      return isAdmin()
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        && sizedList('ingredients', 300) && sizedList('shades', 100) && sizedList('sources', 40) && sizedList('aliases', 60)
        && sizedList('tags', 20) && sizedList('ingredientIds', 300) && sizedList('ingredientNotes', 100)
        && httpsOrEmpty('imageUrl') && httpsOrEmpty('logoUrl') && httpsOrEmpty('website') && httpsOrEmpty('websiteSuggested');
    }
    // A brand's CONFIRMED website (its pages are labelled "Manufacturer's own site" in the app and on the website) may only
    // be set by an admin who records themself as the one who confirmed it. A suggestion (websiteSuggested) is not trusted.
    function websiteConfirmedOnCreate() {
      return request.resource.data.get('website', '') == ''
        || request.resource.data.get('websiteConfirmedBy', '') == request.auth.uid;
    }
    function websiteConfirmedOnUpdate() {
      return request.resource.data.get('website', '') == resource.data.get('website', '')
        || websiteConfirmedOnCreate();
    }

    // ---- catalogue: the website writes it, the app reads it ---------------------------------
    match /brands/{brandId} {
      allow read: if true;
      allow delete: if isAdmin();
      // the app may add a brand it met in a scan: always Pending, so the app does not use it until an admin approves it
      allow create: if (adminCatalogueWrite() && websiteConfirmedOnCreate())
        || (addedByTheApp()
            && brandId.matches('scan_.*')
            && request.resource.data.keys().hasOnly(['name', 'category', 'market', 'status', 'scans', 'source', 'reviewed', 'addedBy', 'addedAtUnix'])
            && request.resource.data.source == 'scan'
            && request.resource.data.status == 'Pending'
            && request.resource.data.scans == 0
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 60
            && request.resource.data.get('category', 'Skincare') in ['Makeup', 'Skincare']);
      // the app may add exactly 1 to "scans" and change nothing else
      allow update: if (adminCatalogueWrite() && websiteConfirmedOnUpdate())
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scans'])
            && request.resource.data.scans == resource.data.get('scans', 0) + 1);
    }

    match /products/{productId} {
      allow read: if true;
      allow delete: if isAdmin();
      // the app may add a product it met in a scan: always Pending, so it is not recommended until an admin approves it.
      // Only make-up and face products are taken (see faceProduct above).
      // The website also keeps "folder" (how the admins arranged it) and "binned" (it is in the Recycle bin) here.
      allow create: if adminCatalogueWrite()
        || (addedByTheApp()
            && productId.matches('scan_.*')
            && request.resource.data.keys().hasOnly(['name', 'brandId', 'brandName', 'cosmeticType', 'description', 'ingredients', 'shades', 'sources',
                 'minAge', 'status', 'scans', 'source', 'reviewed', 'addedBy', 'addedAtUnix', 'barcode'])
            // "barcode": the digits under the product's barcode, when the camera saw them
            && request.resource.data.get('barcode', '') is string
            && request.resource.data.get('barcode', '').matches('[0-9]{0,20}')
            && request.resource.data.source == 'scan'
            && request.resource.data.status == 'Pending'
            && request.resource.data.scans == 0
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 100
            && request.resource.data.get('cosmeticType', '') is string
            && faceProduct(request.resource.data.get('cosmeticType', ''), request.resource.data.name)
            && request.resource.data.ingredients is list
            && request.resource.data.ingredients.size() >= 1
            && request.resource.data.ingredients.size() <= 80
            && request.resource.data.shades is list
            && request.resource.data.shades.size() <= 12
            && request.resource.data.get('sources', []) is list
            && request.resource.data.get('sources', []).size() <= 10);
      // the app may add exactly 1 to "scans" (a scan was recognised as this product) and change nothing else
      allow update: if adminCatalogueWrite()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scans'])
            && request.resource.data.scans == resource.data.get('scans', 0) + 1);
    }

    // A web-found list for a product already in the catalogue is submitted for an admin to review.
    // The app cannot alter the catalogue entry itself or read other users' proposals.
    match /productIngredientSuggestions/{suggestionId} {
      allow read, update, delete: if isAdmin();
      // an admin's document import may also queue a list for a product that has none (it is applied or dismissed here)
      allow create: if isAdmin()
        || addedByTheApp()
        && request.resource.data.keys().hasOnly([
             'productId', 'productName', 'brandName', 'ingredients', 'sources', 'source', 'status', 'reviewed', 'addedBy', 'addedAtUnix'])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() >= 1
        && request.resource.data.productId.size() <= 128
        && request.resource.data.productName is string
        && request.resource.data.productName.size() >= 1
        && request.resource.data.productName.size() <= 100
        && request.resource.data.brandName is string
        && request.resource.data.brandName.size() <= 60
        && request.resource.data.ingredients is list
        && request.resource.data.ingredients.size() >= 3
        && request.resource.data.ingredients.size() <= 80
        && request.resource.data.sources is list
        && request.resource.data.sources.size() >= 1
        && request.resource.data.sources.size() <= 10
        && request.resource.data.source == 'web'
        && request.resource.data.status == 'Pending';
    }

    match /ingredients/{ingredientId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow update: if adminCatalogueWrite();
      // the app may add an ingredient its AI lookup found. It is marked source "ai" and "not reviewed";
      // the app treats such an entry as a warning at most, never as proof that an ingredient is safe.
      allow create: if adminCatalogueWrite()
        || (addedByTheApp()
            && ingredientId.matches('ai_.*')
            && request.resource.data.keys().hasOnly(['name', 'techName', 'description', 'riskLevel', 'cautionNote', 'commonUses', 'fdaUnii', 'model',
                 'minAge', 'keyActive', 'umbrella', 'aliases', 'allergenTags', 'avoidForSkinTypes', 'avoidForConditions',
                 'goodForSkinTypes', 'goodForConditions', 'sources', 'source', 'reviewed', 'webSearched', 'addedBy', 'addedAtUnix'])
            && request.resource.data.source == 'ai'
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 3
            && request.resource.data.name.size() <= 80
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 700
            && request.resource.data.riskLevel in ['safe', 'caution', 'harmful']
            && request.resource.data.aliases is list
            && request.resource.data.aliases.size() <= 10
            && request.resource.data.sources is list
            && request.resource.data.sources.size() <= 10);
    }

    // ---- ingredient classifications: everyone reads (the app shows them), only an admin writes. An ingredient links by document id. ----
    // "other" is the safe fallback: it can be renamed, never deleted. ADDED on 5 November 2026.
    match /ingredientClassifications/{classificationId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin() && classificationId != 'other';
    }

    // The TEST copy of the list: a preview or a local copy of the website uses this one, so looking at them never touches the real list.
    // Nothing reads it but the website's test pages. ADDED on 5 November 2026.
    match /ingredientClassificationsTest/{classificationId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin() && classificationId != 'other';
    }

    // ---- each app user's own data -----------------------------------------------------------
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /scans/{scanId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- anonymous scan notes for the dashboard: the app adds them, only admins read them ----
    // The sizes are generous (the app sends at most 10 flagged names); they only stop a script from filling the dashboard with huge notes.
    match /scanActivity/{activityId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'productName', 'brandId', 'brandName', 'cosmeticType', 'status', 'source', 'scannedAtUnix',
             'ingredientCount', 'harmfulCount', 'cautionCount', 'allergenFlagged', 'flaggedIngredients'])
        && request.resource.data.status in ['safe', 'caution', 'harmful']
        && request.resource.data.scannedAtUnix is number
        && request.resource.data.get('productName', '') is string && request.resource.data.get('productName', '').size() <= 200
        && request.resource.data.get('brandId', '') is string && request.resource.data.get('brandId', '').size() <= 200
        && request.resource.data.get('brandName', '') is string && request.resource.data.get('brandName', '').size() <= 200
        && request.resource.data.get('cosmeticType', '') is string && request.resource.data.get('cosmeticType', '').size() <= 100
        && request.resource.data.get('source', '') is string && request.resource.data.get('source', '').size() <= 20
        && request.resource.data.get('flaggedIngredients', []) is list && request.resource.data.get('flaggedIngredients', []).size() <= 50;
      allow read, delete: if isAdmin();
    }

    // ---- allergens / skin conditions a user typed in because they were not on the app's lists ----
    function validSuggestion() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 100;
    }

    match /allergenSuggestions/{suggestionId} {
      allow create: if validSuggestion();
      allow read, update, delete: if isAdmin();
    }

    match /conditionSuggestions/{suggestionId} {
      allow create: if validSuggestion();
      allow read, update, delete: if isAdmin();
    }

    // ---- AI photo snapshots: products the catalogue does not have, read by the AI from one photo -------------
    // Staged here, NOT in "products", so unverified user content never mixes with the curated catalogue. Signed-in app users
    // may read their OWN entry and create one: always pending, never approved, their own id, make-up only, short lists. Only an admin approves, edits or deletes.
    // The id is made from the brand and the name ("snap_<brand>__<name>"), so the same product is ONE entry for everybody.
    // Read: the sender's own entry, or an admin. The app only ever reads the entry whose id ends with the user's own id, so another user's
    // entry (a product name and the sender's id) is no longer readable by every signed-in account. A document that does not exist may be
    // asked for (resource == null), so the app still gets "not found" instead of an error.
    match /pending_products/{pendingId} {
      allow get: if signedIn() && (resource == null || resource.data.createdByUid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && pendingId.matches('snap_.+') && pendingId.size() <= 110
        && request.resource.data.key is string && request.resource.data.name is string && request.resource.data.brandName is string
        && idFitsNames(pendingId, request.resource.data, request.auth.uid)
        && request.resource.data.keys().hasOnly(['name', 'brandName', 'cosmeticType', 'shadeHex', 'ingredients', 'key', 'status', 'source',
             'isApproved', 'hasImage', 'confidence', 'model', 'createdByUid', 'createdAtUnix', 'variant', 'size', 'sourceUrls'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.isApproved == false
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'snapshot'
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
        && request.resource.data.brandName is string && request.resource.data.brandName.size() <= 60
        && request.resource.data.cosmeticType is string
        && faceProduct(request.resource.data.cosmeticType, request.resource.data.name)
        && request.resource.data.ingredients is list && request.resource.data.ingredients.size() <= 80
        && (!('variant' in request.resource.data) || (request.resource.data.variant is string && request.resource.data.variant.size() <= 60))
        && (!('size' in request.resource.data) || (request.resource.data['size'] is string && request.resource.data['size'].size() <= 40))
        && (!('sourceUrls' in request.resource.data) || (request.resource.data.sourceUrls is list && request.resource.data.sourceUrls.size() <= 5
             && httpsLink(request.resource.data.sourceUrls, 0) && httpsLink(request.resource.data.sourceUrls, 1) && httpsLink(request.resource.data.sourceUrls, 2)
             && httpsLink(request.resource.data.sourceUrls, 3) && httpsLink(request.resource.data.sourceUrls, 4)))
        && request.resource.data.createdAtUnix is number;
      allow update, delete: if isAdmin();
    }

    // Daily limits of the photo function (api/scan-snapshot.js). The function writes these with the USER'S OWN token, so it needs no
    // service account. A counter can only go up by exactly 1, the day is the server's day, and the cool-down is checked here.
    // Keep 5, 150 and 30 equal to PER_UID_DAILY, GLOBAL_DAILY and COOLDOWN_SECONDS in that file.
    //   <uid>_<day>  one account: count (at most 5), lastAt (at least 30 s after the previous one), uid, day
    //   all_<day>    everybody: count (at most 150); only accepted in the same commit that moves the caller's own counter
    match /snapshot_quota/{quotaId} {
      allow get: if signedIn() && quotaId == request.auth.uid + '_' + dayStamp(request.time);
      allow list, delete: if false;
      allow create, update: if signedIn() && (
        (quotaId == request.auth.uid + '_' + dayStamp(request.time)
          && request.resource.data.keys().hasOnly(['uid', 'day', 'count', 'lastAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.day == dayStamp(request.time)
          && request.resource.data.count == (resource == null ? 1 : resource.data.count + 1)
          && request.resource.data.count <= 5
          && request.resource.data.lastAt == request.time
          && (resource == null || request.time >= resource.data.lastAt + duration.value(30, 's')))
        || (quotaId == 'all_' + dayStamp(request.time)
          && request.resource.data.keys().hasOnly(['day', 'count'])
          && request.resource.data.day == dayStamp(request.time)
          && request.resource.data.count == (resource == null ? 1 : resource.data.count + 1)
          && request.resource.data.count <= 150
          && getAfter(/databases/$(database)/documents/snapshot_quota/$(request.auth.uid + '_' + dayStamp(request.time))).data.lastAt == request.time));
    }

    // The photo of a snapshot, in its own document so phones never download it: admins read it next to the AI's reading.
    // It can only be created for an entry that exists (or is written in the same batch) and is the caller's own, with hasImage = true.
    // About 80 KB as a JPG, at most 120,000 characters of base64. Deleted when the entry is approved or rejected.
    match /pending_product_images/{pendingId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && pendingId.matches('snap_.+') && pendingId.size() <= 110
        && request.resource.data.keys().hasOnly(['jpegBase64', 'bytes', 'createdByUid', 'createdAtUnix'])
        && request.resource.data.createdByUid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/pending_products/$(pendingId))
        && getAfter(/databases/$(database)/documents/pending_products/$(pendingId)).data.createdByUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/pending_products/$(pendingId)).data.hasImage == true
        && request.resource.data.jpegBase64 is string && request.resource.data.jpegBase64.size() <= 120000
        && request.resource.data.createdAtUnix is number;
      allow update: if false;
    }

    // ---- the editable lists (allergen families, highlights, skin conditions): ONE document, config/lists ----
    // The app reads it (about once per list check); only an admin writes it, and only this one document.
    // Shape: { version, updatedAt, allergens: [item], conditions: [item], highlights: [item] }, item = { id, label, keywords, retired }.
    match /config/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && docId == 'lists'
        && request.resource.data.keys().hasOnly(['version', 'updatedAt', 'allergens', 'conditions', 'highlights'])
        && request.resource.data.version is number
        && request.resource.data.allergens is list && request.resource.data.allergens.size() <= 40
        && request.resource.data.conditions is list && request.resource.data.conditions.size() <= 40
        && request.resource.data.highlights is list && request.resource.data.highlights.size() <= 40;
      allow delete: if false;
    }

    // ---- the Archive: entries that left the Recycle bin, kept 30 days, then deleted by the server job ----
    // Admins only. An entry is created once (id "<collection>__<id>"), never changed; the job deletes it after expires_at.
    // ADDED on 29 October 2026 (ARCHIVE_DESIGN.md), published on 5 November 2026.
    match /archive/{entryId} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'sourceCollection', 'sourceId', 'name', 'data', 'deleted_at', 'expires_at',
             'deleted_by', 'deleted_by_email', 'archivedWith'])
        && ((request.resource.data.type == 'ingredient' && request.resource.data.sourceCollection == 'ingredients')
            || (request.resource.data.type == 'brand' && request.resource.data.sourceCollection == 'brands')
            || (request.resource.data.type == 'product' && request.resource.data.sourceCollection == 'products'))
        && request.resource.data.sourceId is string
        && entryId == request.resource.data.sourceCollection + '__' + request.resource.data.sourceId
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.data is map
        && request.resource.data.deleted_by == request.auth.uid
        && request.resource.data.deleted_at == request.time
        && request.resource.data.expires_at is timestamp
        && request.resource.data.expires_at > request.time + duration.value(29, 'd')
        && request.resource.data.expires_at < request.time + duration.value(31, 'd');
    }

    // what the purge job did on each run; written only by the job (its service account is outside these rules)
    match /archive_purge_log/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // anything not listed above is closed
  }
}
