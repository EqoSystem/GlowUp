rules_version = '2';

// GlowUp: one database shared by the admin website and the mobile app.
//
// BEFORE YOU PUBLISH THESE RULES: add your own admin account to the "admins" collection
// (see FIRESTORE_SCHEMA.md, "Admin accounts"). Without that document the website can still
// read, but every Save and Delete on the website will be refused.
//
// To publish: firebase deploy --only firestore:rules (Vercel does not publish these).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // An admin is an account whose UID is the id of a document in "admins", OR an account that carries the custom claim admin = true
    // (set with the Firebase Admin SDK, never from a browser or the app: a claim cannot be changed by its owner). The website's login
    // gate still looks at "admins"; the claim is for scripts and tools that sign in as an admin. Neither path can be set from the app.
    function isAdmin() {
      return signedIn()
        && (request.auth.token.get('admin', false) == true
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // signed in within the last 5 minutes (account deletion, 12 November 2026): the app re-authenticates and refreshes its token first
    function recentLogin() {
      return request.auth.token.auth_time > request.time.toMillis() / 1000 - 300;
    }

    // What the app itself adds to the catalogue (an ingredient its AI lookup found, a product or
    // brand it met in a scan) must carry the user's own id and must be marked "not reviewed".
    // The app can only CREATE such entries: it can never change or delete anything in the catalogue.
    function addedByTheApp() {
      return signedIn()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.reviewed == false
        && request.resource.data.addedAtUnix is number;
    }

    // GlowUp lists MAKE-UP AND FACE PRODUCTS ONLY. What the app adds from a scan must not be a hair, body, nail or
    // fragrance product. The same rule as productScope() on the website (adminCommon.js) and ProductScope.cs in the app:
    // a make-up type is always fine; otherwise a hair / body word is refused unless a face word stands next to it.
    function makeupWords(text) {
      return text.matches('(?is).*\\b(lipstick|lip gloss|lip tint|lip balm|lip liner|gloss|tint|foundation|concealer|primer|powder|blush|blusher|bronzer|highlighter|contour|eyeshadow|eye shadow|eyeliner|liner|mascara|brow|cushion|bb cream|cc cream|makeup|make-up|setting spray)\\b.*');
    }
    function faceWords(text) {
      return text.matches('(?is).*\\b(face|facial|lip|lips|eye|eyes|brow|brows|lash|lashes|cheek|cheeks|complexion)\\b.*');
    }
    function notFaceWords(text) {
      return text.matches('(?is).*\\b(shampoo|conditioner|hair|scalp|body|hand|hands|foot|feet|nail|nails|deodorant|antiperspirant|perfume|fragrance|cologne|eau de|soap|shower|bath|shaving|shave|toothpaste|oral|intimate|baby|tanning|massage)\\b.*');
    }
    function faceProduct(type, name) {
      return makeupWords(type) || !notFaceWords(type + ' ' + name) || faceWords(type + ' ' + name);
    }

    // item i of a list of links: absent, or text of at most 300 characters starting with https:// (nothing else is accepted)
    // an optional field that is "" or one https link of at most 300 characters
    function linkOrEmpty(data, key) {
      return !(key in data) || (data[key] is string && (data[key] == '' || (data[key].size() <= 300 && data[key].matches('https://[^ ]+'))));
    }

    function httpsLink(list, i) {
      return list.size() <= i || (list[i] is string && list[i].size() <= 300 && list[i].matches('https://[^ ]+'));
    }

    // The id of a staged product is made from its brand, its name and the sender: "snap_<brand>__<name>__<uid>", brand and name each as lower-case letters and digits with "_"
    // between the words (PendingProductRepository.IdFor in the app). Nobody can stage a product under another product's id: for names in
    // plain ASCII the id must be exactly what the brand and the name make (cut at 110 characters). A name with accents or another alphabet
    // is folded by the app in a way these rules cannot repeat, so for those the id only has to match the stored key.
    function slugOf(t) {
      return t.lower().replace('[^a-z0-9]+', '_').replace('^_+|_+$', '');
    }
    function plainAscii(t) {
      return t.matches('[ -~]*');
    }
    function stagedId(brand, name) {
      let b = slugOf(brand);
      return 'snap_' + (b == '' ? 'nobrand' : b) + '__' + slugOf(name);
    }
    // The id ends with "__" + the sender's account id, so every user has an entry of their own and nobody can block another user by staging
    // a product first. The name part is cut so that the whole id is at most 110 characters.
    function idFitsNames(id, data, uid) {
      let tail = '__' + uid;
      let base = id.replace(tail + '$', '');
      return id == 'snap_' + data.key
        && id.matches('snap_.+' + tail)
        && (!(plainAscii(data.brandName) && plainAscii(data.name))
            || base == stagedId(data.brandName, data.name)
            || (base.size() == 110 - tail.size() && base.matches('[a-z0-9_]+') && stagedId(data.brandName, data.name).matches(base + '.*')));
    }

    // the UTC day as 20261022: the quota documents are named with it, so a client cannot pick another day
    function dayStamp(t) {
      return string(t.year() * 10000 + t.month() * 100 + t.day());
    }

    // ---- who is an admin -------------------------------------------------------------------
    // Created and removed only by hand in the Firebase console. An account may look up its own
    // entry (the website does this when "REQUIRE_ADMIN_RECORD" is switched on).
    // ADDED on 20 November 2026 (admin sign-up): an admin may also ADD an admin, but only by approving that person's own
    // request in "adminRequests" (pending, e-mail confirmed), in the same batch that marks the request approved. Nobody can
    // add themself, and changing or removing an admin is still done by hand in the console.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow create: if isAdmin()
        && uid != request.auth.uid
        && exists(/databases/$(database)/documents/adminRequests/$(uid))
        && get(/databases/$(database)/documents/adminRequests/$(uid)).data.status == 'pending'
        && get(/databases/$(database)/documents/adminRequests/$(uid)).data.emailVerified == true
        && request.resource.data.keys().hasOnly(['email', 'name', 'approvedBy', 'approvedAt'])
        && request.resource.data.email == get(/databases/$(database)/documents/adminRequests/$(uid)).data.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt == request.time;
      allow update, delete: if false;
    }

    // ---- requests for admin access (the login page's "Sign Up"), ONE document per account: adminRequests/{uid} ----
    // ADDED on 20 November 2026. Signing up never makes anyone an admin: the person's own account writes a pending request,
    // and an existing admin approves it (see admins above) or declines it (deletes the request).
    // - the owner creates it (pending, own e-mail, not already an admin) and may later only switch emailVerified to true,
    //   and only when the sign-in token says the e-mail is confirmed;
    // - an admin reads every request, marks one approved in the batch that adds the admin, or deletes it.
    match /adminRequests/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && !exists(/databases/$(database)/documents/admins/$(uid))
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'emailVerified', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.email.size() > 3
        && request.resource.data.status == 'pending'
        && (request.resource.data.emailVerified == false
            || (request.resource.data.emailVerified == true && request.auth.token.get('email_verified', false) == true))
        && request.resource.data.createdAt == request.time;
      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified'])
          && request.resource.data.emailVerified == true
          && request.auth.token.get('email_verified', false) == true)
        || (isAdmin()
          && uid != request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt'])
          && request.resource.data.status == 'approved'
          && request.resource.data.decidedBy == request.auth.uid
          && request.resource.data.decidedAt == request.time
          && existsAfter(/databases/$(database)/documents/admins/$(uid)));
      allow delete: if isAdmin() || isOwner(uid);
    }

    // What an admin may write to the catalogue (brands, products, ingredients). The website's own forms keep to this already;
    // the rule is a second lock: a name that is not text, a list that is absurdly long, or a "link" that is not an https
    // address is refused, whatever tool wrote it. Kept loose on purpose so old entries can still be saved.
    function sizedList(field, most) {
      return request.resource.data.get(field, []) is list && request.resource.data.get(field, []).size() <= most;
    }
    // the source link beside a box of the Ingredient form (10 November 2026): empty, or one https address of at most 600 characters
    function sourceLinkOrEmpty(field) {
      return request.resource.data.get(field, '') == ''
        || (request.resource.data.get(field, '') is string
            && request.resource.data.get(field, '').matches('https://.*')
            && request.resource.data.get(field, '').size() <= 600);
    }
    function ingredientSourceLinks() {
      return sourceLinkOrEmpty('purposeSourceUrl') && sourceLinkOrEmpty('definitionSourceUrl') && sourceLinkOrEmpty('chemicalSourceUrl')
        && sourceLinkOrEmpty('aliasesSourceUrl') && sourceLinkOrEmpty('cautionSourceUrl') && sourceLinkOrEmpty('commonlyUsedInSourceUrl');
    }

    function httpsOrEmpty(field) {
      return request.resource.data.get(field, '') == ''
        || (request.resource.data.get(field, '') is string
            && request.resource.data.get(field, '').matches('https://.*')
            && request.resource.data.get(field, '').size() <= 300);
    }
    function adminCatalogueWrite() {
      return isAdmin()
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        && sizedList('ingredients', 300) && sizedList('shades', 100) && sizedList('sources', 40) && sizedList('aliases', 60)
        && sizedList('tags', 20) && sizedList('ingredientIds', 300) && sizedList('ingredientNotes', 100)
        && httpsOrEmpty('imageUrl') && httpsOrEmpty('logoUrl') && httpsOrEmpty('website') && httpsOrEmpty('websiteSuggested');
    }
    // A brand's CONFIRMED website (its pages are labelled "Manufacturer's own site" in the app and on the website) may only
    // be set by an admin who records themself as the one who confirmed it. A suggestion (websiteSuggested) is not trusted.
    function websiteConfirmedOnCreate() {
      return request.resource.data.get('website', '') == ''
        || request.resource.data.get('websiteConfirmedBy', '') == request.auth.uid;
    }
    function websiteConfirmedOnUpdate() {
      return request.resource.data.get('website', '') == resource.data.get('website', '')
        || websiteConfirmedOnCreate();
    }

    // ---- catalogue: the website writes it, the app reads it ---------------------------------
    match /brands/{brandId} {
      allow read: if true;
      allow delete: if isAdmin();
      // the app may add a brand it met in a scan: always Pending, so the app does not use it until an admin approves it
      allow create: if (adminCatalogueWrite() && websiteConfirmedOnCreate())
        || (addedByTheApp()
            && brandId.matches('scan_.*')
            && request.resource.data.keys().hasOnly(['name', 'category', 'market', 'status', 'scans', 'source', 'reviewed', 'addedBy', 'addedAtUnix'])
            && request.resource.data.source == 'scan'
            && request.resource.data.status == 'Pending'
            && request.resource.data.scans == 0
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 60
            && request.resource.data.get('category', 'Skincare') in ['Makeup', 'Skincare']);
      // the app may add exactly 1 to "scans" and change nothing else
      allow update: if (adminCatalogueWrite() && websiteConfirmedOnUpdate())
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scans'])
            && request.resource.data.scans == resource.data.get('scans', 0) + 1);
    }

    match /products/{productId} {
      allow read: if true;
      allow delete: if isAdmin();
      // the app may add a product it met in a scan: always Pending, so it is not recommended until an admin approves it.
      // Only make-up and face products are taken (see faceProduct above).
      // The website also keeps "folder" (how the admins arranged it) and "binned" (it is in the Recycle bin) here.
      allow create: if adminCatalogueWrite()
        || (addedByTheApp()
            && productId.matches('scan_.*')
            && request.resource.data.keys().hasOnly(['name', 'brandId', 'brandName', 'cosmeticType', 'description', 'ingredients', 'shades', 'sources',
                 'minAge', 'status', 'scans', 'source', 'reviewed', 'addedBy', 'addedAtUnix', 'barcode'])
            // "barcode": the digits under the product's barcode, when the camera saw them
            && request.resource.data.get('barcode', '') is string
            && request.resource.data.get('barcode', '').matches('[0-9]{0,20}')
            && request.resource.data.source == 'scan'
            && request.resource.data.status == 'Pending'
            && request.resource.data.scans == 0
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 100
            && request.resource.data.get('cosmeticType', '') is string
            && faceProduct(request.resource.data.get('cosmeticType', ''), request.resource.data.name)
            && request.resource.data.ingredients is list
            && request.resource.data.ingredients.size() >= 1
            && request.resource.data.ingredients.size() <= 80
            && request.resource.data.shades is list
            && request.resource.data.shades.size() <= 12
            && request.resource.data.get('sources', []) is list
            && request.resource.data.get('sources', []).size() <= 10);
      // the app may add exactly 1 to "scans" (a scan was recognised as this product) and change nothing else
      allow update: if adminCatalogueWrite()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scans'])
            && request.resource.data.scans == resource.data.get('scans', 0) + 1);
    }

    // A web-found list for a product already in the catalogue is submitted for an admin to review.
    // The app cannot alter the catalogue entry itself or read other users' proposals.
    match /productIngredientSuggestions/{suggestionId} {
      allow read, update, delete: if isAdmin();
      // an admin's document import may also queue a list for a product that has none (it is applied or dismissed here)
      allow create: if isAdmin()
        || addedByTheApp()
        && request.resource.data.keys().hasOnly([
             'productId', 'productName', 'brandName', 'ingredients', 'sources', 'source', 'status', 'reviewed', 'addedBy', 'addedAtUnix'])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() >= 1
        && request.resource.data.productId.size() <= 128
        && request.resource.data.productName is string
        && request.resource.data.productName.size() >= 1
        && request.resource.data.productName.size() <= 100
        && request.resource.data.brandName is string
        && request.resource.data.brandName.size() <= 60
        && request.resource.data.ingredients is list
        && request.resource.data.ingredients.size() >= 3
        && request.resource.data.ingredients.size() <= 80
        && request.resource.data.sources is list
        && request.resource.data.sources.size() >= 1
        && request.resource.data.sources.size() <= 10
        && request.resource.data.source == 'web'
        && request.resource.data.status == 'Pending';
    }

    match /ingredients/{ingredientId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow update: if adminCatalogueWrite() && ingredientSourceLinks();
      // the app may add an ingredient its AI lookup found. It is marked source "ai" and "not reviewed";
      // the app treats such an entry as a warning at most, never as proof that an ingredient is safe.
      allow create: if (adminCatalogueWrite() && ingredientSourceLinks())
        || (addedByTheApp()
            && ingredientId.matches('ai_.*')
            && request.resource.data.keys().hasOnly(['name', 'techName', 'description', 'riskLevel', 'cautionNote', 'commonUses', 'fdaUnii', 'model',
                 'minAge', 'keyActive', 'umbrella', 'aliases', 'allergenTags', 'avoidForSkinTypes', 'avoidForConditions',
                 'goodForSkinTypes', 'goodForConditions', 'sources', 'source', 'reviewed', 'webSearched', 'addedBy', 'addedAtUnix'])
            && request.resource.data.source == 'ai'
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 3
            && request.resource.data.name.size() <= 80
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 700
            && request.resource.data.riskLevel in ['safe', 'caution', 'harmful']
            && request.resource.data.aliases is list
            && request.resource.data.aliases.size() <= 10
            && request.resource.data.sources is list
            && request.resource.data.sources.size() <= 10);
    }

    // ---- ingredient classifications: everyone reads (the app shows them), only an admin writes. An ingredient links by document id. ----
    // "other" is the safe fallback: it can be renamed, never deleted. ADDED on 5 November 2026.
    match /ingredientClassifications/{classificationId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin() && classificationId != 'other';
    }

    // The TEST copy of the list: a preview or a local copy of the website uses this one, so looking at them never touches the real list.
    // Nothing reads it but the website's test pages. ADDED on 5 November 2026.
    match /ingredientClassificationsTest/{classificationId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin() && classificationId != 'other';
    }

    // ---- each app user's own data -----------------------------------------------------------
    // ---- audit trail: one record per save made on the admin website (adminStore.js writes it in the same batch as the change).
    // An admin may add a record for themself only; nobody may change or delete a record, so the trail cannot be tidied away. ADDED 6 November 2026.
    match /auditLog/{recordId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'at', 'atUnix', 'page', 'count', 'items'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.atUnix is int
        && request.resource.data.atUnix > request.time.toMillis() / 1000 - 120
        && request.resource.data.atUnix < request.time.toMillis() / 1000 + 120
        && request.resource.data.page is string && request.resource.data.page.size() <= 120
        && request.resource.data.count is int
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 450
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ---- each app user's own data -----------------------------------------------------------
    // CHANGED on 20 November 2026 (User Management page; the project owner chose full access for admins): an admin may READ every
    // users/{uid} (profile and skin profile) and may change only the fields the admin site manages. The app's own writes are
    // merges of the profile fields, so they never touch these. A user cannot set or change them (no self-unban, no self-role), and
    // a banned user cannot write their profile. The scans below stay private to the user. Permanent delete removes the profile
    // document only: the Firebase sign-in account and the scans sub-collection stay (no Cloud Functions on the free tier).
    function userAdminFields() { return ['status', 'statusBefore', 'role', 'inBin', 'statusChangedAt', 'statusChangedBy']; }
    function userBanned(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('status', '') == 'banned';
    }
    function userPhotoOk() {
      return request.resource.data.get('photoData', '') is string
        && request.resource.data.get('photoData', '').size() <= 200100
        && (request.resource.data.get('photoData', '') == '' || request.resource.data.get('photoData', '').matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }
    function adminUserChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'username'].concat(userAdminFields()))
        && request.resource.data.get('role', 'user') in ['user', 'admin']
        && request.resource.data.get('status', 'active') in ['active', 'archived', 'banned', 'deleted']
        && (request.resource.data.get('statusChangedBy', request.auth.uid) == request.auth.uid)
        && request.resource.data.get('fullName', '') is string && request.resource.data.get('fullName', '').size() <= 100
        && request.resource.data.get('username', '') is string && request.resource.data.get('username', '').size() <= 50;
    }
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // photoData (New22): the app's profile picture, a small JPEG as text (the app sends about 20 KB); capped here
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(userAdminFields()) && userPhotoOk();
      allow update: if (isOwner(uid) && !userBanned(uid) && userPhotoOk()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(userAdminFields()))
                    || (isAdmin() && uid != request.auth.uid && adminUserChange());
      allow delete: if (isOwner(uid) && recentLogin())       // only during account deletion, right after a fresh sign-in
                    || (isAdmin() && uid != request.auth.uid && resource.data.get('status', '') == 'deleted');   // permanent delete from the Recycle Bin

      match /scans/{scanId} {
        allow read, write: if isOwner(uid);
      }

      // ---- the user's notifications (New22, 20 November 2026): an admin's reply to a report. Only admins create one;
      // the user reads it, marks it read, or deletes it, and nobody else sees it ----
      match /notifications/{noteId} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['kind', 'title', 'body', 'reportId', 'read', 'createdAt', 'createdBy'])
          && request.resource.data.kind in ['reply']
          && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
          && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 500
          && request.resource.data.get('reportId', '') is string && request.resource.data.get('reportId', '').size() <= 100
          && request.resource.data.read == false
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
      }
    }

    // ---- anonymous scan notes for the dashboard: the app adds them, only admins read them ----
    // The sizes are generous (the app sends at most 10 flagged names); they only stop a script from filling the dashboard with huge notes.
    match /scanActivity/{activityId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'productName', 'brandId', 'brandName', 'cosmeticType', 'status', 'source', 'scannedAtUnix',
             'ingredientCount', 'harmfulCount', 'cautionCount', 'allergenFlagged', 'flaggedIngredients'])
        && request.resource.data.status in ['safe', 'caution', 'harmful']
        && request.resource.data.scannedAtUnix is number
        && request.resource.data.get('productName', '') is string && request.resource.data.get('productName', '').size() <= 200
        && request.resource.data.get('brandId', '') is string && request.resource.data.get('brandId', '').size() <= 200
        && request.resource.data.get('brandName', '') is string && request.resource.data.get('brandName', '').size() <= 200
        && request.resource.data.get('cosmeticType', '') is string && request.resource.data.get('cosmeticType', '').size() <= 100
        && request.resource.data.get('source', '') is string && request.resource.data.get('source', '').size() <= 20
        && request.resource.data.get('flaggedIngredients', []) is list && request.resource.data.get('flaggedIngredients', []).size() <= 50;
      allow read, delete: if isAdmin();
    }

    // ---- allergens / skin conditions a user typed in because they were not on the app's lists ----
    function validSuggestion() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 100;
    }

    match /allergenSuggestions/{suggestionId} {
      allow create: if validSuggestion();
      allow read, update, delete: if isAdmin();
    }

    match /conditionSuggestions/{suggestionId} {
      allow create: if validSuggestion();
      allow read, update, delete: if isAdmin();
    }

    // ---- Contact support (10 November 2026): the app writes a report, the admin website's Dashboard lists it -------------
    // A signed-in user may CREATE their own report only (their own uid, status "new", a message of 3 to 2000 characters, one of three
    // kinds). Nobody but an admin may read, change or delete a report. "lastScan" is there only when the user switched it on.
    match /supportReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'userName', 'category', 'message', 'status', 'appVersion', 'device', 'createdAtUnix', 'createdAt', 'lastScan'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.category in ['Bug', 'Wrong scan result', 'Suggestion', 'Other']     // Suggestion: 11 November 2026 (app Settings > Contact support)
        && request.resource.data.get('userName', '') is string && request.resource.data.get('userName', '').size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 2000
        && request.resource.data.get('appVersion', '') is string && request.resource.data.get('appVersion', '').size() <= 40
        && request.resource.data.get('device', '') is string && request.resource.data.get('device', '').size() <= 200
        && (!('lastScan' in request.resource.data) || (request.resource.data.lastScan is map && request.resource.data.lastScan.size() <= 6));
      allow read, update, delete: if isAdmin();
    }

    // ---- AI photo snapshots: REMOVED on 11 November 2026 (the app matches photos with the catalogue only; no web search) --------
    // Nobody creates these any more. The app still asks for its own entry by id (the live scan's look-up), and an admin may
    // still read and delete what is left from before.
    match /pending_products/{pendingId} {
      allow get: if signedIn() && (resource == null || resource.data.createdByUid == request.auth.uid || isAdmin());
      allow list, delete: if isAdmin();
      allow create, update: if false;
    }
    match /snapshot_quota/{quotaId} {
      allow read, write: if false;
    }
    match /pending_product_images/{pendingId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // ---- the editable lists (allergen families, highlights, skin conditions): ONE document, config/lists ----
    // The app reads it (about once per list check); only an admin writes it, and only this one document.
    // Shape: { version, updatedAt, allergens: [item], conditions: [item], highlights: [item] }, item = { id, label, keywords, retired }.
    match /config/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && docId == 'lists'
        && request.resource.data.keys().hasOnly(['version', 'updatedAt', 'allergens', 'conditions', 'highlights'])
        && request.resource.data.version is number
        && request.resource.data.allergens is list && request.resource.data.allergens.size() <= 40
        && request.resource.data.conditions is list && request.resource.data.conditions.size() <= 40
        && request.resource.data.highlights is list && request.resource.data.highlights.size() <= 40;
      allow delete: if false;
    }

    // ---- shared default layouts of the admin website: ONE document per page, siteLayouts/{page} ----
    // ADDED on 9 November 2026 (Layout & Style > "Make this the default for everyone"). Admins only. The website cleans what it
    // reads (componentStyle.js / adminLayouts.js), so the rule checks the shape and the size only.
    match /siteLayouts/{pageKey} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && pageKey in ['dashboard', 'inventory', 'curator', 'bin', 'archive', 'users']
        && request.resource.data.keys().hasOnly(['layout', 'appearance', 'updatedAt', 'updatedBy'])
        && request.resource.data.layout is map
        && request.resource.data.appearance is map
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // ---- keyboard shortcuts: one document per admin, only that admin reads or writes it ----
    // ADDED on 9 November 2026 (Quick settings > Keyboard shortcuts, shortcutStore.js). Any other account, admin or not, is refused.
    // The website cleans what it reads (shortcutKeys.js mergeWithCatalog), so the rule checks the owner, the shape and the size.
    match /adminShortcuts/{uid} {
      allow read, delete: if isAdmin() && request.auth.uid == uid;
      allow create, update: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['items', 'seeded', 'updatedAt'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 80
        && request.resource.data.seeded is list
        && request.resource.data.seeded.size() <= 120
        && request.resource.data.updatedAt == request.time;
    }

    // ---- saved layouts (Layout & Style): one document per admin, only that admin reads or writes it ----
    // ADDED on 17 November 2026 (personalLayouts.js) so a layout made on one device ("Echo") shows on every device the admin
    // signs in on. `store` is the layouts as JSON text; the website cleans what it reads (adminLayouts.js cleanStore).
    match /adminLayouts/{uid} {
      allow read, delete: if isAdmin() && request.auth.uid == uid;
      allow create, update: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['store', 'savedAt', 'updatedAt'])
        && request.resource.data.store is string
        && request.resource.data.store.size() <= 900000
        && request.resource.data.savedAt is int
        && request.resource.data.updatedAt == request.time;
    }

    // ---- the Archive: entries that left the Recycle bin, kept 30 days, then deleted by the server job ----
    // Admins only. An entry is created once (id "<collection>__<id>"), never changed; the job deletes it after expires_at.
    // ADDED on 29 October 2026 (ARCHIVE_DESIGN.md), published on 5 November 2026.
    match /archive/{entryId} {
      allow read, delete: if isAdmin();
      allow update: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'sourceCollection', 'sourceId', 'name', 'data', 'deleted_at', 'expires_at',
             'deleted_by', 'deleted_by_email', 'archivedWith'])
        && ((request.resource.data.type == 'ingredient' && request.resource.data.sourceCollection == 'ingredients')
            || (request.resource.data.type == 'brand' && request.resource.data.sourceCollection == 'brands')
            || (request.resource.data.type == 'product' && request.resource.data.sourceCollection == 'products'))
        && request.resource.data.sourceId is string
        && entryId == request.resource.data.sourceCollection + '__' + request.resource.data.sourceId
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.data is map
        && request.resource.data.deleted_by == request.auth.uid
        && request.resource.data.deleted_at == request.time
        && request.resource.data.expires_at is timestamp
        && request.resource.data.expires_at > request.time + duration.value(29, 'd')
        && request.resource.data.expires_at < request.time + duration.value(31, 'd');
    }

    // what the purge job did on each run; written only by the job (its service account is outside these rules)
    match /archive_purge_log/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- announcements to every app user (New22, 20 November 2026): maintenance notices, app updates, product changes ----
    // Any signed-in user reads them (the app's Notifications screen); only admins write them, in a fixed shape.
    match /announcements/{noteId} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind', 'title', 'body', 'startsAt', 'endsAt', 'createdAt', 'createdBy'])
        && request.resource.data.kind in ['maintenance', 'update', 'product']
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() <= 300
        && (request.resource.data.get('startsAt', null) == null || request.resource.data.get('startsAt', null) is timestamp)
        && (request.resource.data.get('endsAt', null) == null || request.resource.data.get('endsAt', null) is timestamp)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // ---- Maintenance Mode (New22, 20 November 2026): ONE document, systemConfig/maintenanceMode ----
    // Everyone may read it, also before signing in (the app's log-in screen must know it). Only admins write it, in a fixed shape.
    // Ending maintenance when scheduledEnd passes is done by any open admin tab (no Cloud Functions on the free tier).
    match /systemConfig/{docId} {
      allow get: if docId == 'maintenanceMode';
      allow list, delete: if false;
      allow create, update: if isAdmin() && docId == 'maintenanceMode'
        && request.resource.data.keys().hasOnly(['isActive', 'scheduledStart', 'scheduledEnd', 'bannerTitle', 'customMessage', 'notifyUsers', 'notifiedAt', 'updatedBy', 'updatedAt'])
        && request.resource.data.isActive is bool
        && request.resource.data.notifyUsers is bool
        && (request.resource.data.scheduledStart == null || request.resource.data.scheduledStart is timestamp)
        && (request.resource.data.scheduledEnd == null || request.resource.data.scheduledEnd is timestamp)
        && (request.resource.data.notifiedAt == null || request.resource.data.notifiedAt is timestamp)
        && request.resource.data.bannerTitle is string && request.resource.data.bannerTitle.size() <= 80
        && request.resource.data.customMessage is string && request.resource.data.customMessage.size() <= 300
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }


    // anything not listed above is closed
  }
}
